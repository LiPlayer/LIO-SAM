<?xml version="1.0"?>
<robot name="lio" xmlns:xacro="http://tixiaoshan.github.io/">
  <xacro:property name="PI" value="3.1415926535897931" />

  <!-- Base link - root of the robot -->
  <link name="base_link"></link>

  <!-- Unilidar sensor assembly link - matches Gazebo unilidar_link -->
  <!-- This represents the physical sensor housing containing both LiDAR and IMU -->
  <link name="unilidar_link"></link>
  <joint name="unilidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="unilidar_link" />
    <origin xyz="0 0 0.065" rpy="0 0 0" />
  </joint>

  <!-- LiDAR sensor frame - matches Gazebo sensor frame_id -->
  <!-- Co-located with unilidar_link (no offset) -->
  <link name="unilidar_lidar"></link>
  <joint name="lidar_joint" type="fixed">
    <parent link="unilidar_link" />
    <child link="unilidar_lidar" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- IMU sensor frame - matches Gazebo sensor frame_id -->
  <!-- Co-located with LiDAR in the same sensor housing -->
  <link name="unilidar_imu"></link>
  <joint name="imu_joint" type="fixed">
    <parent link="unilidar_link" />
    <child link="unilidar_imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

</robot>
