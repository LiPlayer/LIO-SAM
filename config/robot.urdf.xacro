<?xml version="1.0"?>
<robot name="lio" xmlns:xacro="http://tixiaoshan.github.io/">
  <xacro:property name="PI" value="3.1415926535897931" />

  <!-- Base link - root of the robot -->
  <link name="base_link"></link>

  <!-- GzLidar sensor assembly link - matches Gazebo gzlidar_link -->
  <!-- This represents the physical sensor housing containing both LiDAR and IMU -->
  <link name="lidar_link"></link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0 0 0.065" rpy="0 0 0" />
  </joint>

  <!-- LiDAR sensor frame - matches Gazebo sensor frame_id -->
  <!-- Co-located with lidar_link (no offset) -->
  <link name="lidar_cloud"></link>
  <joint name="lidar_cloud_joint" type="fixed">
    <parent link="lidar_link" />
    <child link="lidar_cloud" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- IMU sensor frame - matches Gazebo sensor frame_id -->
  <!-- Co-located with LiDAR in the same sensor housing -->
  <link name="lidar_imu"></link>
  <joint name="lidar_imu_joint" type="fixed">
    <parent link="lidar_link" />
    <child link="lidar_imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

</robot>
